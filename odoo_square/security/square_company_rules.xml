<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="square_config_company_rule" model="ir.rule">
        <field name="name">Square config: allowed companies</field>
        <field name="model_id" ref="model_square_config"/>
        <field name="domain_force">[("company_id", "in", company_ids)]</field>
    </record>
    <record id="square_location_mapping_company_rule" model="ir.rule">
        <field name="name">Square location mapping: allowed companies</field>
        <field name="model_id" ref="model_square_location_mapping"/>
        <field name="domain_force">[("config_id.company_id", "in", company_ids)]</field>
    </record>
    <record id="square_integration_log_company_rule" model="ir.rule">
        <field name="name">Square integration log: allowed companies</field>
        <field name="model_id" ref="model_square_integration_log"/>
        <field name="domain_force">[("company_id", "in", company_ids)]</field>
    </record>
    <record id="square_refund_company_rule" model="ir.rule">
        <field name="name">Square refund: allowed companies</field>
        <field name="model_id" ref="model_square_refund"/>
        <field name="domain_force">[("sale_order_id.company_id", "in", company_ids)]</field>
    </record>
    <record id="square_webhook_queue_company_rule" model="ir.rule">
        <field name="name">Square webhook queue: allowed companies</field>
        <field name="model_id" ref="model_square_webhook_queue"/>
        <field name="domain_force">[("config_id.company_id", "in", company_ids)]</field>
    </record>
</odoo>
