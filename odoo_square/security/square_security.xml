<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_square_pos_service" model="res.groups">
        <field name="name">Square POS Integration Service</field>
    </record>

    <record id="rule_square_config_company" model="ir.rule">
        <field name="name">Square POS configuration company</field>
        <field name="model_id" ref="model_square_config"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_square_mapping_company" model="ir.rule">
        <field name="name">Square POS location mapping company</field>
        <field name="model_id" ref="model_square_location_mapping"/>
        <field name="domain_force">[('config_id.company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_square_log_company" model="ir.rule">
        <field name="name">Square POS diagnostic company</field>
        <field name="model_id" ref="model_square_integration_log"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_square_queue_company" model="ir.rule">
        <field name="name">Square POS webhook company</field>
        <field name="model_id" ref="model_square_webhook_queue"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_square_refund_company" model="ir.rule">
        <field name="name">Square POS refund company</field>
        <field name="model_id" ref="model_square_refund"/>
        <field name="domain_force">[('sale_order_id.company_id', 'in', company_ids)]</field>
    </record>
</odoo>
