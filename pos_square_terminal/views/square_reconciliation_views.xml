<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="square_reconciliation_list" model="ir.ui.view">
        <field name="name">pos.square.payment.attempt.reconciliation.list</field>
        <field name="model">pos.square.payment.attempt</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" default_order="id desc">
                <field name="order_id"/>
                <field name="payment_method_id"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="requested_amount"/>
                <field name="state"/>
                <field name="square_payment_id"/>
                <field name="last_checked_at" string="Last Successful Check"/>
                <field name="connection_id" optional="hide"/>
                <field name="reconciliation_discrepancy" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="square_reconciliation_form" model="ir.ui.view">
        <field name="name">pos.square.payment.attempt.reconciliation.form</field>
        <field name="model">pos.square.payment.attempt</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0" duplicate="0">
                <header>
                    <button name="action_check_square_payment" type="object" string="Check Square Payment"
                            class="oe_highlight" invisible="state in ('prepared', 'ready', 'blocked', 'failed')"/>
                </header>
                <sheet>
                    <field name="has_verified_amounts" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <group>
                        <group>
                            <field name="order_id"/>
                            <field name="payment_method_id"/>
                            <field name="requested_amount"/>
                            <field name="verified_base" invisible="not has_verified_amounts"/>
                            <field name="verified_tip" invisible="not has_verified_amounts"/>
                        </group>
                        <group>
                            <field name="state"/>
                            <field name="provider_status" string="Square Terminal Status"/>
                            <field name="last_checked_at" string="Last Successful Check"/>
                            <field name="order_pricing_discrepancy" invisible="not order_pricing_discrepancy"/>
                            <field name="reconciliation_discrepancy" invisible="not reconciliation_discrepancy"/>
                            <field name="reconciliation_error" string="Latest Check Error"
                                   invisible="not reconciliation_error or reconciliation_error == reconciliation_discrepancy"/>
                        </group>
                    </group>
                    <group string="Original Square References">
                        <group>
                            <field name="connection_id" context="{'active_test': False}"/>
                            <field name="environment"/>
                            <field name="merchant_id"/>
                            <field name="square_location_id"/>
                            <field name="square_device_id"/>
                        </group>
                        <group>
                            <field name="payment_uuid" string="Odoo Payment Reference"/>
                            <field name="reference" string="Square Checkout Reference"/>
                            <field name="square_order_id"/>
                            <field name="square_checkout_id"/>
                            <field name="square_payment_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_square_reconciliation" model="ir.actions.act_window">
        <field name="name">Square Terminal Payments</field>
        <field name="res_model">pos.square.payment.attempt</field>
        <field name="view_mode">list,form</field>
        <field name="groups_id" eval="[(4, ref('point_of_sale.group_pos_manager'))]"/>
    </record>
    <menuitem id="menu_square_reconciliation" name="Square Terminal Payments" parent="point_of_sale.menu_point_of_sale"
              action="action_square_reconciliation" groups="point_of_sale.group_pos_manager" sequence="3"/>

    <record id="pos_order_square_reconciliation_form" model="ir.ui.view">
        <field name="name">pos.order.square.terminal.reconciliation.form</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_square_reconciliation" type="object" class="oe_stat_button" icon="fa-credit-card"
                        groups="point_of_sale.group_pos_manager" invisible="not square_reconciliation_count">
                    <field name="square_reconciliation_count" widget="statinfo" string="Square Payments"/>
                </button>
            </xpath>
        </field>
    </record>

    <record id="square_connection_webhook_form" model="ir.ui.view">
        <field name="name">pos.square.connection.webhook.form</field>
        <field name="model">pos.square.connection</field>
        <field name="inherit_id" ref="square_connection_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[field[@name='location_ids']]" position="before">
                <group string="Square Notifications" invisible="not merchant_id">
                    <field name="webhook_endpoint" string="Webhook Endpoint" widget="CopyClipboardChar"/>
                    <field name="webhook_url"/>
                    <field name="new_webhook_signature_key" password="True"/>
                    <field name="has_webhook_signature_key" string="Webhook Key Saved"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
