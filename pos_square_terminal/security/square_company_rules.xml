<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="square_connection_company_rule" model="ir.rule">
        <field name="name">Square Terminal connection company</field>
        <field name="model_id" ref="model_pos_square_connection"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="square_location_company_rule" model="ir.rule">
