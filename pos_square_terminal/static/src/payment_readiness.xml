<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="pos_square_terminal.PaymentScreenMethods" t-inherit="point_of_sale.PaymentScreenMethods" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('paymentmethod')]" position="attributes">
            <attribute name="t-att-class">
                {
                    'opacity-50': (this.pos.paymentTerminalInProgress and paymentMethod.use_payment_terminal) or this.squareUnavailableReason(paymentMethod),
                    'd-flex justify-content-between align-items-center': true
                }
            </attribute>
            <attribute name="t-att-aria-disabled">this.squareUnavailableReason(paymentMethod) ? 'true' : undefined</attribute>
        </xpath>
        <xpath expr="//span[hasclass('payment-name')]" position="replace">
            <div>
                <span class="payment-name" t-esc="paymentMethod.name"/>
                <small class="d-block mt-1"
                       t-if="this.squareUnavailableReason(paymentMethod)"
                       t-esc="this.squareUnavailableReason(paymentMethod)"/>
            </div>
        </xpath>
    </t>
</templates>
