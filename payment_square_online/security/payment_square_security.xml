<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="payment_provider_square_company_rule" model="ir.rule">
        <field name="name">Square providers belong to the exact Odoo company</field>
        <field name="model_id" ref="payment.model_payment_provider"/>
        <field name="domain_force">['|', ('code', '!=', 'square_online'), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="payment_square_location_company_rule" model="ir.rule">
        <field name="name">Square locations belong to the exact Odoo company</field>
        <field name="model_id" ref="model_payment_square_location"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
