<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="square_online_connection_company_rule" model="ir.rule">
        <field name="name">Square connections of allowed companies</field>
        <field name="model_id" ref="model_square_online_connection"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="square_online_location_company_rule" model="ir.rule">
        <field name="name">Square locations of allowed companies</field>
        <field name="model_id" ref="model_square_online_location"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
