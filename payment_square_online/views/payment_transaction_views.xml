<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_transaction_form" model="ir.ui.view">
        <field name="name">payment.transaction.form.square.online</field>
        <field name="model">payment.transaction</field>
        <field name="inherit_id" ref="payment.payment_transaction_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/field[@name='state']" position="before">
                <field name="square_online_dispatch_at" invisible="1"/>
                <button name="action_square_online_refresh_status" type="object" string="Refresh status"
                        invisible="provider_code != 'square_online' or not (square_online_dispatch_at or square_online_refund_origin == 'square')"
                        groups="account.group_account_manager,base.group_system"/>
            </xpath>
            <xpath expr="//group[@name='transaction_details']" position="after">
                <group string="Square history" invisible="provider_code != 'square_online'">
                    <field name="square_online_order_id"/>
                    <field name="square_online_environment"/>
                    <field name="square_online_merchant_id"/>
                    <field name="square_online_location_id"/>
                    <field name="square_online_refund_origin" invisible="not square_online_refund_origin"/>
                    <field name="square_online_refund_requested_by" invisible="not square_online_refund_requested_by"/>
                    <field name="square_online_recovery_checked_at"/>
                    <field name="square_online_recovery_message" invisible="not square_online_recovery_message"/>
                </group>
            </xpath>
            <xpath expr="//group[@name='transaction_details']/.." position="before">
                <field name="square_online_has_order_mismatch" invisible="1"/>
                <div class="alert alert-warning" role="alert" invisible="not square_online_has_order_mismatch">
                    Square collected this payment after the order changed. Review the payment and order before fulfilling it.
                </div>
            </xpath>
        </field>
    </record>

    <record id="action_square_online_transaction_history" model="ir.actions.act_window">
        <field name="name">Square Payment History</field>
        <field name="res_model">payment.transaction</field>
        <field name="view_mode">list,form</field>
        <field name="path">square-payment-history</field>
        <field name="domain">[('provider_code', '=', 'square_online'), '|', '|', ('square_online_dispatch_at', '!=', False), ('square_online_refund_requested_by', '!=', False), '&amp;', ('operation', '=', 'refund'), ('provider_reference', '!=', False)]</field>
    </record>

    <menuitem id="square_online_transaction_history_menu" parent="account.root_payment_menu"
              action="action_square_online_transaction_history" sequence="30"
              groups="account.group_account_manager,base.group_system"/>
</odoo>
