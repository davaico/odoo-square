<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_provider_form" model="ir.ui.view">
        <field name="name">Square Online Payment Provider</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider_credentials" position="inside">
                <group invisible="code != 'square_online'" groups="base.group_system">
                    <field name="square_online_sandbox_connection_id"
                           domain="[('company_id', '=', company_id), ('environment', '=', 'sandbox')]"
                           options="{'no_create': True}"/>
                    <field name="square_online_production_connection_id"
                           domain="[('company_id', '=', company_id), ('environment', '=', 'production')]"
                           options="{'no_create': True}"/>
                    <button type="object" name="action_square_online_connections"
                            string="Manage Square Connections" class="btn-link" colspan="2"/>
                    <div class="text-muted" colspan="2">
                        Test Mode uses the sandbox connection. Enabled uses the production connection.
                        Choose the Payment Journal under Configuration before publishing the provider.
                    </div>
                </group>
            </group>
        </field>
    </record>
</odoo>
