<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="payment_provider_square_online" model="payment.provider">
            <field name="name">Square Online Payments</field>
            <field name="code">square_online</field>
            <field name="state">disabled</field>
            <field name="payment_method_ids" eval="[Command.set([ref('payment.payment_method_card')])]"/>
        </record>
    </data>
    <function model="payment.provider" name="write">
        <function model="payment.provider" name="search"
                  eval="[[('code', '=', 'square_online'), ('inline_form_view_id', '=', False)]]"/>
        <value eval="{'inline_form_view_id': ref('payment_square_online.inline_form')}"/>
    </function>
</odoo>
