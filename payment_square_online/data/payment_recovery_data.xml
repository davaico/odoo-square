<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_square_online_renew" model="ir.cron">
        <field name="name">Square Online Payments: Renew OAuth access</field>
        <field name="model_id" ref="model_payment_square_connection"/>
        <field name="state">code</field>
        <field name="code">model._cron_square_renew_authorizations()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
    </record>
    <record id="ir_cron_square_online_reconcile" model="ir.cron">
        <field name="name">Square Online Payments: Reconcile transactions</field>
        <field name="model_id" ref="payment.model_payment_transaction"/>
        <field name="state">code</field>
        <field name="code">model._cron_square_reconcile()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
    </record>
    <record id="ir_cron_square_online_webhooks" model="ir.cron">
        <field name="name">Square Online Payments: Process webhooks</field>
        <field name="model_id" ref="model_payment_square_webhook_event"/>
        <field name="state">code</field>
        <field name="code">model._cron_square_webhooks()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
    </record>
    <record id="ir_cron_square_online_discover_refunds" model="ir.cron">
        <field name="name">Square Online Payments: Discover refunds</field>
        <field name="model_id" ref="model_payment_square_connection"/>
        <field name="state">code</field>
        <field name="code">model._cron_square_discover_refunds()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
    </record>
</odoo>
