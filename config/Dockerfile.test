FROM odoo:19.0

USER root
RUN export LC_ALL=C.UTF-8 DEBIAN_FRONTEND=noninteractive \
    && install -d -m 0755 /etc/apt/keyrings \
    && curl --fail --location --silent --show-error \
        --output /etc/apt/keyrings/google-chrome.asc \
        https://dl.google.com/linux/linux_signing_key.pub \
    && printf '%s\n' 'deb [arch=amd64 signed-by=/etc/apt/keyrings/google-chrome.asc] https://dl.google.com/linux/chrome/deb/ stable main' \
        > /etc/apt/sources.list.d/google-chrome.list \
    && apt-get update -o APT::Update::Error-Mode=any \
    && apt-get upgrade --yes \
    && apt-get install --yes --no-install-recommends google-chrome-stable python3-websocket \
    && rm -rf /var/lib/apt/lists/*
USER odoo
