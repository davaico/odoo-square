FROM odoo:19.0-20260908

USER root
RUN curl --fail --location --show-error \
        --output /tmp/google-chrome-stable.deb \
        https://dl.google.com/linux/chrome/deb/pool/main/g/google-chrome-stable/google-chrome-stable_153.0.8010.52-1_amd64.deb \
    && echo "29e0e4b5af01213915ffdb7f4e49a11956dc5fc591165c85af8688dcdff907ac  /tmp/google-chrome-stable.deb" \
        | sha256sum --check --strict \
    && apt-get update \
    && apt-get install --yes --no-install-recommends /tmp/google-chrome-stable.deb python3-websocket \
    && rm -f /tmp/google-chrome-stable.deb \
    && rm -rf /var/lib/apt/lists/*
USER odoo
