# Odoo Square Integration - Environment Variables
# Copy this file to .env and update with your values

# Database Configuration
DB_NAME=odoo_square_v18
DB_HOST=db
DB_USER=odoo
DB_PASSWORD=change_me_to_a_secure_password
ODOO_HTTP_PORT=8069

# Square online payments only. Keep the generated key private and back it up.
# ODOO_SQUARE_ONLINE_ENCRYPTION_KEY=

# Square Terminal for Point of Sale only. Keep the generated key private and back it up.
# ODOO_SQUARE_TERMINAL_ENCRYPTION_KEY=
